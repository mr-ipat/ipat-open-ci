[Unit]
Description=IPAT R9.30 pusat manajemen langsung (tunnel opsional) private owner-authorized lab SSH+Telnet real read evidence status (NO DEVICE EXECUTION)
Documentation=https://github.com/mr-ipat/ipat
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/openai/.cache/ipat/r930-release/src
ExecStart=/home/openai/.cache/ipat/r930-release/target/debug/control-api
Environment=IPAT_LAB_WEB=1
Environment=IPAT_R911_PRIVATE_CANARY=YES
Environment=IPAT_R916_DEV_SITE_A_KEY_FOLDER=/home/openai/.local/share/ipat/r916-dev-keys
Environment=IPAT_RUN_K3S_LAB=0
Environment=IPAT_LAB_OIDC_VERIFY=NO
Environment=IPAT_LAB_SCOPED_MEMBERSHIP=NO
Environment=IPAT_R83_REGISTRY_WRITE=NO
Environment=IPAT_R84_SIMULATED_REVIEW=NO
Environment=IPAT_R86_BROWSER_FLOW=NO
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
MemoryMax=256M
CPUQuota=20%
TasksMax=32
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
