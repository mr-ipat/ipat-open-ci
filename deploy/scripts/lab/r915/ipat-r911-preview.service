[Unit]
Description=IPAT R9.15 central Site A hub planning private preview (NO DEVICES)
Documentation=https://github.com/mr-ipat/ipat
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/openai/.cache/ipat/r915-preview/src
ExecStart=/home/openai/.cache/ipat/r915-preview/target/debug/control-api
Environment=IPAT_LAB_WEB=1
Environment=IPAT_R911_PRIVATE_CANARY=YES
Environment=IPAT_RUN_K3S_LAB=0
Environment=IPAT_LAB_OIDC_VERIFY=NO
Environment=IPAT_LAB_SCOPED_MEMBERSHIP=NO
Environment=IPAT_R83_REGISTRY_WRITE=NO
Environment=IPAT_R84_SIMULATED_REVIEW=NO
Environment=IPAT_R86_BROWSER_FLOW=NO
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
MemoryMax=256M
CPUQuota=20%
TasksMax=32
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
